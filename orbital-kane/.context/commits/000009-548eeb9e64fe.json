slug":"ac-21","by":{"kind":"ai","id":"design-agent"}},{"cid":"sha256:8ffc6020fea1a5bc7e34242a6e345c4029c5e4ee1e4a1c12ba85caa3f2d9d9fb","slug":"ac-22","by":{"kind":"ai","id":"design-agent"}},{"cid":"sha256:5346f111f6e999d5e73b12d32ed18d8c9b4c4c5008f07bf17186b5136b2d5154","slug":"ac-23","by":{"kind":"ai","id":"design-agent"}},{"cid":"sha256:f0a8bf58131ae73b4a0379b7d83719d368fd8ee8640f986979ef0b606ea5f14e","slug":"ac-24","by":{"kind":"ai","id":"design-agent"}}],"judgements":[{"about":"sha256:6d4a8dcf1d9ed43a1803d3da65b82559a09f4418bcb9e341394192bd86ea1277","rationale":"[risk_factors] Applied user-reach and change-frequency because every investment professional uses the overview chart and time-range recalculation is a common UI/data binding regression point.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:32b9c5018653f0ad69c32ceb52a779b2aea13ae31cd04b5de7d5a494ae968200","rationale":"[risk_factors] Applied user-reach and change-frequency because incorrect x-axis relabeling misleads all overview users and is tightly coupled to chart-range changes.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:2a483f4e6cb79717449b8e8a392ec410af63cfd2fb6697c5c011baad486eaacf","rationale":"[risk_factors] Applied user-reach and change-frequency because period comparison is a user-visible interpretation aid and is likely to move when chart-period behavior changes.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:fda21c0f54b188e513bc7d218a75c41852236fa905a0610bfd54d63e1ff7e25f","rationale":"[risk_factors] Applied user-reach and change-frequency because summary-card stability affects the primary dashboard readout and hover-driven regressions are common in interactive charts.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:12ed3ef8ae15a978c23ea6080bbe49b183f5b5f46fd1ac5447befcd3a32127ef","rationale":"[risk_factors] Applied user-reach because the single-active-state rule is visible to all users of the time-range control.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:197b8c892205491ec8ecd78ea4ec03946474f8787b2952ba8a63df967d1be9a7","rationale":"[risk_factors] Applied user-reach because the default range determines the first view every user receives on the overview.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:d489d3f08c0b756bfc8b40c7b2c926b9f342adfe45326ba1617987da27090463","rationale":"[risk_factors] Applied user-reach because the available range options are part of the main overview control surface for all users.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:76c68c75dc5559db6d029a958b989fad1c8b8ce52eca26a608456de2ccb1a514","rationale":"[risk_factors] Applied user-reach because the portfolio series is core chart content visible to all users.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:a40083dbe13d700a58d1bed66565b53f7e825a24a31926cffb0ea0e29b5168dc","rationale":"[risk_factors] Applied user-reach because the benchmark series is core comparison content visible to all users.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:826a6feb10ea188288daee4e7f528d9baecd339c24c1f3ba99bfeef7f0c24945","rationale":"[risk_factors] Applied user-reach because the grid is a visible reading aid on the main chart surface.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:11d4130c74f57dbdc9a5f7a67d83a511e429c18a57b9270ffaaa64274ba1a6de","rationale":"[risk_factors] Applied user-reach because the x-axis is required for interpreting chart time data across the overview.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:8ffc6020fea1a5bc7e34242a6e345c4029c5e4ee1e4a1c12ba85caa3f2d9d9fb","rationale":"[risk_factors] Applied user-reach because the y-axis is required for interpreting chart values across the overview.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:5346f111f6e999d5e73b12d32ed18d8c9b4c4c5008f07bf17186b5136b2d5154","rationale":"[risk_factors] Applied user-reach because the area fill is visible chart context for all overview users.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:f0a8bf58131ae73b4a0379b7d83719d368fd8ee8640f986979ef0b606ea5f14e","rationale":"[risk_factors] Applied user-reach and change-frequency because tooltip implementation is visible during chart inspection and often changes when chart libraries or interaction layers change.","by":{"kind":"ai","id":"design-agent"}}],"design_of":{"uc_cid":"sha256:1d87852815c4e262c73cd2e66b6542d66e44c14bd8d821fea1ad812e709c6776","engine":"design@1"},"design_generation":{"uc_root":"sha256:1d87852815c4e262c73cd2e66b6542d66e44c14bd8d821fea1ad812e709c6776","uc_cid":"sha256:1d87852815c4e262c73cd2e66b6542d66e44c14bd8d821fea1ad812e709c6776","generation":1,"supersedes_generation":null,"by":{"kind":"ai","id":"design-agent"}},"event_ids":["design-20260820T171348-af5c:design:1"],"sid":"design-20260820T171348-af5c","design_phase":{"uc_root":"sha256:1d87852815c4e262c73cd2e66b6542d66e44c14bd8d821fea1ad812e709c6776","generation":1,"phase":"acs","completeness":"complete"},"schema_version":"assurance/context@1","parents":["sha256:344ec9ad6e1a963fb73b54f60b08f5b6d15611a0bb8d698270dafc0fa487470c"]}
