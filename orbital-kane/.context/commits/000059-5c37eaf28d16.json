df56a9d31806714f60e0070e04304b5eb41a2e8ce75ede0b896b97afca03c0f","dst":"sha256:1103ee16e0a0a26cb7259058df9175e46c51690447df1a03af8e0a3723031d84","props":{}}],"review":[],"supersessions":[],"source_head_moves":{},"names":[{"cid":"sha256:65c484402f32bcbcd8f2c91f21ed6188f8bfbc4c24d905c4901b3c4b44558663","slug":"ac-165","by":{"kind":"ai","id":"design-agent"}}],"judgements":[{"about":"sha256:42e1ecdc6729ae56137bde5cb4d97d728b88df0bc90e19cca4ca560d8a640997","rationale":"[applicability] Applicable because the shortcut path ends in a focused field, so the scenario can prove the focused-border styling promise.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:42e1ecdc6729ae56137bde5cb4d97d728b88df0bc90e19cca4ca560d8a640997","rationale":"[applicability] Not applicable because this scenario proves focus acquisition, not Escape dismissal or overlay clearing.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:42e1ecdc6729ae56137bde5cb4d97d728b88df0bc90e19cca4ca560d8a640997","rationale":"[applicability] Applicable because the shortcut path directly proves the Cmd/Ctrl + K focus transition.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:42e1ecdc6729ae56137bde5cb4d97d728b88df0bc90e19cca4ca560d8a640997","rationale":"[applicability] Applicable because the shortcut path results in the focused state where the focus ring must be visible.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:42e1ecdc6729ae56137bde5cb4d97d728b88df0bc90e19cca4ca560d8a640997","rationale":"[applicability] Applicable because the field remains focused after shortcut entry, allowing the scenario to confirm its width is still 420px.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:42e1ecdc6729ae56137bde5cb4d97d728b88df0bc90e19cca4ca560d8a640997","rationale":"[applicability] Applicable because the field remains focused after shortcut entry, allowing the scenario to confirm its height is still 36px.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:42e1ecdc6729ae56137bde5cb4d97d728b88df0bc90e19cca4ca560d8a640997","rationale":"[applicability] Not applicable because this scenario is about keyboard focus acquisition; the static placeholder copy is more directly proven by the direct-inspection path.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:42e1ecdc6729ae56137bde5cb4d97d728b88df0bc90e19cca4ca560d8a640997","rationale":"[applicability] Not applicable because this scenario starts from an already-focused field only to prove Escape dismissal; it does not distinguish focused border color behavior.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:42e1ecdc6729ae56137bde5cb4d97d728b88df0bc90e19cca4ca560d8a640997","rationale":"[applicability] Applicable because the scenario proves the Escape-clears-focus branch of the invariant dismissal promise.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:42e1ecdc6729ae56137bde5cb4d97d728b88df0bc90e19cca4ca560d8a640997","rationale":"[applicability] Not applicable because this scenario does not use Cmd/Ctrl + K to acquire focus.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:42e1ecdc6729ae56137bde5cb4d97d728b88df0bc90e19cca4ca560d8a640997","rationale":"[applicability] Not applicable because the scenario is scoped to dismissal behavior, not to proving the visibility of focus styling before dismissal.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:42e1ecdc6729ae56137bde5cb4d97d728b88df0bc90e19cca4ca560d8a640997","rationale":"[applicability] Not applicable because the scenario does not compare focused layout dimensions before and after focus entry.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:42e1ecdc6729ae56137bde5cb4d97d728b88df0bc90e19cca4ca560d8a640997","rationale":"[applicability] Not applicable because the scenario does not compare focused layout dimensions before and after focus entry.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:42e1ecdc6729ae56137bde5cb4d97d728b88df0bc90e19cca4ca560d8a640997","rationale":"[applicability] Not applicable because placeholder copy is orthogonal to the Escape-dismissal branch being exercised.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:42e1ecdc6729ae56137bde5cb4d97d728b88df0bc90e19cca4ca560d8a640997","rationale":"[applicability] Applicable because this direct-focus path is a primary way to prove the focused information-blue border styling.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:42e1ecdc6729ae56137bde5cb4d97d728b88df0bc90e19cca4ca560d8a640997","rationale":"[applicability] Not applicable because this scenario proves focus styling and stability, not Escape dismissal.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:42e1ecdc6729ae56137bde5cb4d97d728b88df0bc90e19cca4ca560d8a640997","rationale":"[applicability] Not applicable because this scenario uses direct focus rather than the documented keyboard shortcut.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:42e1ecdc6729ae56137bde5cb4d97d728b88df0bc90e19cca4ca560d8a640997","rationale":"[applicability] Applicable because this direct-focus path proves the visible focus ring on the focused field.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:42e1ecdc6729ae56137bde5cb4d97d728b88df0bc90e19cca4ca560d8a640997","rationale":"[applicability] Applicable because the scenario compares the field before and after direct focus to prove width stability at 420px.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:42e1ecdc6729ae56137bde5cb4d97d728b88df0bc90e19cca4ca560d8a640997","rationale":"[applicability] Applicable because the scenario compares the field before and after direct focus to prove height stability at 36px.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:42e1ecdc6729ae56137bde5cb4d97d728b88df0bc90e19cca4ca560d8a640997","rationale":"[applicability] Applicable because the scenario directly inspects the field's displayed placeholder text as part of the unfocused and focused states.","by":{"kind":"ai","id":"design-agent"}}],"design_of":